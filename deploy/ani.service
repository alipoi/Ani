[Unit]
Description=Ani calendar server
After=network.target

[Service]
Type=simple
User=ani
Group=ani
WorkingDirectory=/opt/ani
Environment=NODE_ENV=production
# 如需走代理抓 nyaa/dmhy（国内 VPS）：取消下一行注释并填你的代理
# Environment=HTTPS_PROXY=http://127.0.0.1:7890
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
